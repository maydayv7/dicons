#!/bin/sh
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
export PATH="$PATH:$root/usr/libexec"
if [ ! -d /usr/share/X11/xkb ] && [ -z "${XKB_CONFIG_EXTRA_PATH:-}" ]; then
    export XKB_CONFIG_EXTRA_PATH="$root/usr/share/xkb"
fi
exec "$root/usr/bin/ld-linux-x86-64.so.2" --library-path "$root/usr/lib" "$root/usr/bin/dicons" "$@"
